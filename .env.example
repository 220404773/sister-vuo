LLM_BASE_URL=https://your-llama-endpoint/v1
LLM_API_KEY=replace-me
# Recommended: Llama 3.3 70B Instruct. The ID depends on the provider, e.g.
#   OpenRouter: meta-llama/llama-3.3-70b-instruct   Groq: llama-3.3-70b-versatile
#   Together: meta-llama/Llama-3.3-70B-Instruct-Turbo   Ollama: llama3.3:70b
# 8B models often break the evaluator's JSON. Set LLM_JSON_MODE=true if the provider
# supports response_format.
LLM_MODEL=meta-llama/llama-3.3-70b-instruct
LLM_TIMEOUT_SECONDS=60
LLM_JSON_MODE=false
LLM_PATIENT_MAX_TOKENS=180
LLM_EVALUATOR_MAX_TOKENS=2000

# Set before exposing the app beyond localhost: the REST API and chat UI then require it
# (the UI asks for it once). Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_API_KEY=
SESSION_TTL_MINUTES=120
MAX_ACTIVE_SESSIONS=200

WHATSAPP_VERIFY_TOKEN=replace-me
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Required: the webhook stays disabled without it, so forged payloads are never accepted.
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v23.0
WHATSAPP_TIMEOUT_SECONDS=30
